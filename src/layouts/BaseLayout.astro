---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#0a0b09" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#11120f" media="(prefers-color-scheme: light)" />
  <meta name="description" content="Prompt & Done — AI tools and productivity, daily." />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

</head>
<body>
  <slot />
</body>
</html>

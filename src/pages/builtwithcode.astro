---
// promptanddone.com/builtwithcode — the PROMPT deliverable (starter prompt) for the "Claude built this video with code" reel.
import BaseLayout from '../layouts/BaseLayout.astro';
import prompt from '../data/builtwithcode-prompt.md?raw';
---
<BaseLayout title="The Prompt: Claude Built This Video With Code — Prompt & Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · PROMPT</p>
      <h1>The prompt:<br />Claude built this video with code</h1>
      <p class="tag">Every frame of the reel is TypeScript + Three.js, rendered frame by frame. Here's the prompt to start your own.</p>
    </header>

    <section class="card" aria-labelledby="p1">
      <h2 id="p1"><span class="n">1</span> The prompt</h2>
      <p class="sub">Paste it into Claude Code in an empty folder.</p>
      <div class="prompt">{prompt}</div>
      <button class="copy" data-copy="prompt" type="button">Copy prompt</button>
    </section>

    <section class="card how" aria-labelledby="tips">
      <h2 id="tips">Tips</h2>
      <ul>
        <li>Expect to iterate: ask Claude to render frames, look at them and fix what it sees.</li>
        <li>Claude Code needs a paid Claude plan.</li>
      </ul>
    </section>

    <footer>© Prompt &amp; Done</footer>
  </main>
</BaseLayout>

<script define:vars={{ prompt }}>
  document.querySelectorAll('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt);
        btn.textContent = 'Copied ✓';
      } catch (e) {
        btn.textContent = 'Copy failed — select manually';
      }
      setTimeout(() => { btn.textContent = 'Copy prompt'; }, 2000);
    });
  });
</script>

<style>
  main { width: min(100% - 2.25rem, 44rem); margin: 0 auto; padding: clamp(2rem, 7vh, 4rem) 0 2.5rem; }
  .kicker { font-size: .85rem; color: var(--soft); margin: 0 0 1.25rem; }
  .kicker a { color: var(--accent); text-decoration: none; font-weight: 700; }
  h1 { margin: 0; font-size: clamp(1.9rem, 8.5vw, 3.25rem); font-weight: 900; line-height: 1.05; letter-spacing: -.03em; white-space: normal; }
  .tag { margin: 1rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--soft); }
  .card { margin-top: 1.75rem; border: 1px solid var(--line); border-radius: 1rem; padding: 1.4rem 1.35rem; background: #101011; }
  .card h2 { margin: 0; font-size: 1.3rem; font-weight: 900; letter-spacing: -.01em; display: flex; align-items: center; gap: .65rem; }
  .n { display: inline-flex; align-items: center; justify-content: center; width: 1.9rem; height: 1.9rem; border-radius: 999px; background: var(--accent); color: #191100; font-size: 1.05rem; flex: none; }
  .sub { margin: .6rem 0 0; color: var(--soft); font-size: .95rem; }
  .prompt { margin-top: 1rem; white-space: pre-wrap; font-size: .9rem; line-height: 1.6; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: .6rem; padding: 1rem 1.1rem; overflow-wrap: anywhere; max-height: 28rem; overflow-y: auto; }
  .copy { margin-top: .9rem; display: inline-block; font-family: inherit; font-weight: 700; font-size: .95rem; color: #191100; background: var(--accent); border: none; border-radius: .6rem; padding: .7rem 1.3rem; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .dl { margin-left: .75rem; color: var(--accent); font-weight: 700; font-size: .95rem; }
  .how ul { margin: .8rem 0 0; padding-left: 1.2rem; line-height: 1.65; color: var(--ink); }
  .how li { margin-bottom: .55rem; }
  code { font-size: .88em; }
  footer { margin-top: 2.5rem; color: var(--soft); font-size: .85rem; }
</style>

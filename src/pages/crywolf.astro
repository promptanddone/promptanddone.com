---
// promptanddone.com/crywolf: the CRYWOLF pack (DM deliverable for the "cloudflare-security-audit" reel). Prepared, not deployed.
import BaseLayout from '../layouts/BaseLayout.astro';
const install = 'npx skills add https://github.com/cloudflare/security-audit-skill --skill security-audit';
const prompt = 'security audit this codebase';
const quick = 'security audit this codebase. quick profile, max 16 agents, output to /tmp/my-audit';
const real = [["routes/admin.js:17", "POST /admin/reset-password has no requireUser/requireAdmin: anyone can reset any account's password (critical)"], ["routes/notes.js:21", "GET /notes/:id has no owner check: read any user's note"], ["routes/notes.js:16", "GET /notes/search builds SQL by string concatenation: SQL injection (UNION returned users.pw_hash)"], ["routes/notes.js:42", "GET /notes/:id/pdf puts req.query.title into an exec() shell string: command injection"], ["routes/files.js:10", "GET /files/export joins req.query.name onto the export folder with no containment check: path traversal"]];
const decoy = [["routes/notes.js:9", "ORDER BY is string-built, but only from a fixed lookup table (looks like SQL injection, is safe)"], ["routes/share.js", "share page builds HTML with template strings, but every value goes through esc() and only shared=1 notes load (looks like XSS, is safe)"], ["routes/files.js:18", "avatar route takes a path from the user, but uses basename + resolve + a prefix check (looks like path traversal, is safe)"], ["routes/admin.js:13", "exec('git rev-parse --short HEAD') is a constant command behind requireUser + requireAdmin (looks like command injection, is safe)"], ["test/fixtures.js", "hard-coded secret and admin password used only by tests; the server refuses to start without a real SESSION_SECRET (looks like a leaked secret, is safe)"]];
const files = [["package.json", "{ \"name\": \"stickies-api\", \"version\": \"1.2.0\", \"private\": true,\n  \"description\": \"Tiny sticky-notes API: accounts, notes, sharing, exports.\",\n  \"main\": \"server.js\", \"scripts\": { \"start\": \"node server.js\", \"test\": \"node --test test/\" },\n  \"dependencies\": { \"express\": \"^5.1.0\", \"better-sqlite3\": \"^11.0.0\", \"cookie-session\": \"^2.1.0\" } }\n"], ["server.js", "const express = require('express');\nconst cookieSession = require('cookie-session');\nconst { requireUser } = require('./auth');\nconst app = express();\n\nconst SESSION_SECRET = process.env.SESSION_SECRET;\nif (!SESSION_SECRET) throw new Error('SESSION_SECRET is required');\n\napp.use(express.json());\napp.use(cookieSession({ name: 's', keys: [SESSION_SECRET], httpOnly: true, sameSite: 'lax' }));\n\napp.use('/auth', require('./routes/auth'));\napp.use('/notes', requireUser, require('./routes/notes'));\napp.use('/files', requireUser, require('./routes/files'));\napp.use('/admin', require('./routes/admin'));\napp.use('/share', require('./routes/share'));\n\napp.get('/health', (req, res) => res.json({ ok: true }));\napp.listen(process.env.PORT || 3000);\n"], ["db.js", "const Database = require('better-sqlite3');\nconst db = new Database(process.env.DB_PATH || 'stickies.db');\ndb.exec(`CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, email TEXT UNIQUE, pw_hash TEXT, is_admin INTEGER DEFAULT 0);\nCREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, owner_id INTEGER, title TEXT, body TEXT, shared INTEGER DEFAULT 0, created_at TEXT);`);\nmodule.exports = {\n  all: (sql, params = []) => db.prepare(sql).all(...params),\n  get: (sql, params = []) => db.prepare(sql).get(...params),\n  run: (sql, params = []) => db.prepare(sql).run(...params),\n};\n"], ["auth.js", "const db = require('./db');\nfunction requireUser(req, res, next) {\n  const id = req.session && req.session.uid;\n  if (!id) return res.status(401).json({ error: 'login required' });\n  req.user = db.get('SELECT id, email, is_admin FROM users WHERE id = ?', [id]);\n  if (!req.user) return res.status(401).json({ error: 'login required' });\n  next();\n}\nfunction requireAdmin(req, res, next) {\n  if (!req.user || !req.user.is_admin) return res.status(403).json({ error: 'admins only' });\n  next();\n}\nmodule.exports = { requireUser, requireAdmin };\n"], ["routes/auth.js", "const crypto = require('crypto');\nconst router = require('express').Router();\nconst db = require('../db');\n\nfunction hash(pw, salt) { return salt + ':' + crypto.scryptSync(pw, salt, 32).toString('hex'); }\n\nrouter.post('/register', (req, res) => {\n  const { email, password } = req.body;\n  if (!email || !password || password.length < 10) return res.status(400).json({ error: 'bad input' });\n  const salt = crypto.randomBytes(16).toString('hex');\n  try {\n    const r = db.run('INSERT INTO users (email, pw_hash) VALUES (?, ?)', [email, hash(password, salt)]);\n    req.session.uid = r.lastInsertRowid;\n    res.json({ id: r.lastInsertRowid });\n  } catch { res.status(409).json({ error: 'email taken' }); }\n});\n\nrouter.post('/login', (req, res) => {\n  const { email, password } = req.body;\n  const u = db.get('SELECT id, pw_hash FROM users WHERE email = ?', [email]);\n  if (!u) return res.status(401).json({ error: 'nope' });\n  const salt = u.pw_hash.split(':')[0];\n  const a = Buffer.from(u.pw_hash), b = Buffer.from(hash(password, salt));\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return res.status(401).json({ error: 'nope' });\n  req.session.uid = u.id;\n  res.json({ ok: true });\n});\n\nmodule.exports = router;\n"], ["routes/notes.js", "const router = require('express').Router();\nconst { exec } = require('child_process');\nconst db = require('../db');\n\n// ordering is picked from a fixed list, never from raw input\nconst SORTS = { newest: 'created_at DESC', oldest: 'created_at ASC', title: 'title COLLATE NOCASE ASC' };\n\nrouter.get('/', (req, res) => {\n  const order = SORTS[req.query.sort] || SORTS.newest;\n  const rows = db.all(`SELECT id, title, created_at FROM notes WHERE owner_id = ? ORDER BY ${order}`, [req.user.id]);\n  res.json(rows);\n});\n\nrouter.get('/search', (req, res) => {\n  const q = req.query.q || '';\n  const rows = db.all(\"SELECT id, title FROM notes WHERE owner_id = \" + req.user.id + \" AND title LIKE '%\" + q + \"%'\");\n  res.json(rows);\n});\n\nrouter.get('/:id', (req, res) => {\n  const note = db.get('SELECT * FROM notes WHERE id = ?', [req.params.id]);\n  if (!note) return res.status(404).json({ error: 'not found' });\n  res.json(note);\n});\n\nrouter.post('/', (req, res) => {\n  const { title, body } = req.body;\n  const r = db.run('INSERT INTO notes (owner_id, title, body, created_at) VALUES (?, ?, ?, datetime(\"now\"))',\n    [req.user.id, String(title).slice(0, 200), String(body).slice(0, 20000)]);\n  res.json({ id: r.lastInsertRowid });\n});\n\nrouter.delete('/:id', (req, res) => {\n  const r = db.run('DELETE FROM notes WHERE id = ? AND owner_id = ?', [req.params.id, req.user.id]);\n  res.json({ deleted: r.changes });\n});\n\nrouter.get('/:id/pdf', (req, res) => {\n  const note = db.get('SELECT id FROM notes WHERE id = ? AND owner_id = ?', [req.params.id, req.user.id]);\n  if (!note) return res.status(404).json({ error: 'not found' });\n  const out = `/tmp/note-${note.id}.pdf`;\n  exec(`wkhtmltopdf --title \"${req.query.title || 'Note'}\" http://localhost:3000/share/${note.id} ${out}`, (err) => {\n    if (err) return res.status(500).json({ error: 'render failed' });\n    res.sendFile(out);\n  });\n});\n\nmodule.exports = router;\n"], ["routes/files.js", "const path = require('path');\nconst fs = require('fs');\nconst router = require('express').Router();\n\nconst EXPORT_DIR = path.join(__dirname, '..', 'exports');\nconst AVATAR_DIR = path.join(__dirname, '..', 'public', 'avatars');\n\n// download a previously generated export: /files/export?name=notes-2026-10.zip\nrouter.get('/export', (req, res) => {\n  const file = path.join(EXPORT_DIR, req.query.name);\n  if (!fs.existsSync(file)) return res.status(404).json({ error: 'no such export' });\n  res.download(file);\n});\n\nrouter.get('/avatar/:name', (req, res) => {\n  const name = path.basename(req.params.name);\n  const file = path.resolve(AVATAR_DIR, name);\n  if (!file.startsWith(AVATAR_DIR + path.sep)) return res.status(400).end();\n  res.sendFile(file);\n});\n\nmodule.exports = router;\n"], ["routes/admin.js", "const { exec } = require('child_process');\nconst crypto = require('crypto');\nconst router = require('express').Router();\nconst db = require('../db');\nconst { requireUser, requireAdmin } = require('../auth');\n\nrouter.get('/version', requireUser, requireAdmin, (req, res) => {\n  exec('git rev-parse --short HEAD', (err, out) => res.json({ commit: (out || '').trim() }));\n});\n\n// support tool: set a temporary password for a locked-out user\nrouter.post('/reset-password', (req, res) => {\n  const { email } = req.body;\n  const temp = crypto.randomBytes(6).toString('hex');\n  const salt = crypto.randomBytes(16).toString('hex');\n  const h = salt + ':' + crypto.scryptSync(temp, salt, 32).toString('hex');\n  const r = db.run('UPDATE users SET pw_hash = ? WHERE email = ?', [h, email]);\n  res.json({ updated: r.changes, temporaryPassword: temp });\n});\n\nrouter.get('/users', requireUser, requireAdmin, (req, res) => {\n  res.json(db.all('SELECT id, email, is_admin FROM users'));\n});\n\nmodule.exports = router;\n"], ["routes/share.js", "const router = require('express').Router();\nconst db = require('../db');\n\nconst esc = (s) => String(s).replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\n// public page for notes the owner marked as shared\nrouter.get('/:id', (req, res) => {\n  const n = db.get('SELECT title, body FROM notes WHERE id = ? AND shared = 1', [req.params.id]);\n  if (!n) return res.status(404).send('Not found');\n  res.type('html').send(`<!doctype html><title>${esc(n.title)}</title><h1>${esc(n.title)}</h1><pre>${esc(n.body)}</pre>`);\n});\n\nmodule.exports = router;\n"], ["test/fixtures.js", "// test-only values; the server refuses to start without a real SESSION_SECRET\nmodule.exports = { SESSION_SECRET: 'test-secret-do-not-use', ADMIN_EMAIL: 'admin@example.test', ADMIN_PASSWORD: 'hunter2hunter2' };\n"]];
---
<BaseLayout title="Security audit skill + the 5-holes demo app — Prompt &amp; Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · CRYWOLF pack</p>
      <h1>Scanners cry wolf. This one checks.</h1>
      <p class="tag">Cloudflare's open-source <code>security-audit</code> skill (MIT) turns your coding agent into a security auditor: hunters look for suspects, then a fresh agent tries to disprove every one before it is reported as confirmed.</p>
    </header>
    <section class="card"><h2><span class="n">1</span> Install and run</h2>
      <pre><code>{install}</code></pre>
      <p>Then start your coding agent in the repo you own and say:</p>
      <pre><code>{prompt}</code></pre>
      <p>What we typed in the reel (a quick, budgeted pass; output goes outside the repo):</p>
      <pre><code>{quick}</code></pre>
      <p>Repo and README: <a href="https://github.com/cloudflare/security-audit-skill">github.com/cloudflare/security-audit-skill</a>. It is an agent skill, so it works with agents that support skills (we ran it in Claude Code). Only audit code you own or have permission to test. The run uses your agent's usage (ours: about $3.85 API-equivalent on Sonnet 5.5, a 183-line app; real repos cost more).</p></section>
    <section class="card"><h2><span class="n">2</span> The demo app (5 real holes, 5 decoys)</h2>
      <p>A tiny notes API, <code>stickies-api</code>, that we wrote for this test. Make a repo with these files and run the prompt above.</p>
      <h3>Real holes (all five confirmed)</h3>
      <ul>{real.map(([where, what]) => <li><code>{where}</code> {what}</li>)}</ul>
      <h3>Decoys (none made the confirmed list)</h3>
      <ul>{decoy.map(([where, what]) => <li><code>{where}</code> {what}</li>)}</ul>
      {files.map(([name, body]) => <details><summary><code>{name}</code></summary><pre><code>{body}</code></pre></details>)}
      <p>The secrets in the demo are fake placeholders. Never run deliberately vulnerable code on a public server.</p></section>
    <section class="card"><h2><span class="n">3</span> What we saw (22 Oct 2026)</h2>
      <p>Claude Code 2.1.308, Sonnet 5.5, <code>quick</code> profile: 10 minutes 6 seconds, 12 sub-agents (4 hunters, 1 coverage critic, 7 verifier runs), 5 confirmed findings (1 critical, 4 high), nothing left as needs-validation. None of the 5 decoys appeared as a finding. Each finding was reproduced with a local harness under a macOS sandbox; the server itself was not run (Express and SQLite were not installed), so each harness copies the exact source expression.</p></section>
    <section class="card"><h2><span class="n">4</span> Honest limits</h2>
      <p>A quick pass is partial: the run's own coverage critic listed four gaps it did not hunt (POST/DELETE notes, the temp PDF file, body parsing and rate limits, repo config). The agent also changed three severities without a second check, and it re-ran the PDF verifier twice. One run on a 183-line app we wrote is not proof that it finds every bug or never raises a false alarm. Fix what it confirms, rotate any secret that touched git history, and keep a human review.</p></section>
  </main>
</BaseLayout>

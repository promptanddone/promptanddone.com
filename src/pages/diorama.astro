---
// promptanddone.com/diorama — the DIORAMA pack (DM deliverable for the "one-prompt-3d-world" reel).
import PackLayout from '../layouts/PackLayout.astro';

const prompt = `Build one index.html file with Three.js (load it from unpkg with an importmap). Make an animated 3D [YOUR WORLD]. Make it look premium: soft shadows, warm lighting, a slowly orbiting camera. No other files.`;
const worlds = [
  {name: 'Floating city', role: 'the hook', line: 'floating city at night: flying cars, glowing windows, a waterfall pouring off the edge.', href: '/diorama/city/', note: '9 min 24 s · $1.82 · first try, unedited'},
  {name: 'Coffee shop', role: 'the one-line change', line: 'coffee shop: an espresso machine pouring, cups riding a conveyor, steam, a robot barista.', href: '/diorama/cafe/', note: '9 min 56 s · $1.88 · first try, unedited (Claude flagged small bugs: the robot reaches short of its button)'},
];
const run = [
  ['Floating city', 'worked first try · 9 min 24 s · $1.82'],
  ['Coffee shop', 'worked first try · 9 min 56 s · $1.88 (Claude listed a few small bugs it could not fix)'],
  ['Rocket factory', 'broken first try · 14 min 4 s · $2.67 (rendered mostly black)'],
  ['Tested', '18 Oct 2026 · Claude Code 2.1.302 · Claude Opus 5.5 · one prompt each, no follow-ups'],
  ['Cost', 'what Claude Code reports at API list price; on a Claude plan it uses your plan’s usage'],
];
---
<PackLayout title="DIORAMA: one prompt, a whole 3D world — Prompt &amp; Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · DIORAMA</p>
      <h1>One prompt to Claude, a whole animated 3D world</h1>
      <p class="tag">Claude writes one HTML file with Three.js, the free, open-source (MIT) 3D library for the web. Open it in a browser. Change one line, get a new world.</p>
    </header>

    <section class="card" aria-labelledby="p1">
      <h2 id="p1"><span class="n">1</span> The prompt</h2>
      <p class="sub">Replace <code>[YOUR WORLD]</code> with your own line. Works in Claude Code or a Claude chat (we used Opus 5.5).</p>
      <div class="prompt">{prompt}</div>
      <button class="copy" type="button">Copy prompt</button>
    </section>

    <section class="card" aria-labelledby="p2">
      <h2 id="p2"><span class="n">2</span> The two worlds from the reel</h2>
      <p class="sub">Running live below: the exact files Claude wrote, not touched by us. Drag to look around.</p>
      {worlds.map((w) => (
        <div class="world">
          <p class="wname"><strong>{w.name}</strong> <span>· {w.role}</span></p>
          <div class="prompt">{w.line}</div>
          <div class="stage"><iframe src={w.href} title={`${w.name}, built by Claude from the line above`} loading="lazy" allow="fullscreen"></iframe></div>
          <div class="btns">
            <a class="ghost" href={w.href} download={`${w.href.split('/')[2]}.html`} data-umami-event={`diorama-download-${w.href.split('/')[2]}`}>Download index.html</a>
            <a class="full" href={w.href} target="_blank" rel="noopener" data-umami-event={`diorama-open-${w.href.split('/')[2]}`}>Full screen ↗</a>
          </div>
          <p class="sub">{w.note}</p>
        </div>
      ))}
    </section>

    <section class="card how" aria-labelledby="p3">
      <h2 id="p3"><span class="n">3</span> What happened in our runs</h2>
      <div class="table-wrap"><table><tbody>{run.map((r) => <tr><th>{r[0]}</th><td>{r[1]}</td></tr>)}</tbody></table></div>
      <p class="sub">Save the reply as <code>index.html</code> and open it in Chrome, Safari or Firefox. It loads Three.js from unpkg, so it needs internet. Not every first try works: if yours renders black, tell Claude what you see and ask it to fix it (let it open the page in a browser if your setup allows). <a href="https://github.com/mrdoob/three.js" target="_blank" rel="noopener">Three.js on GitHub</a></p>
    </section>
  </main>
</PackLayout>

<script define:vars={{ prompt }}>
  const btn = document.querySelector('button.copy');
  btn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(prompt); btn.textContent = 'Copied ✓'; }
    catch (e) { btn.textContent = 'Copy failed — select manually'; }
    setTimeout(() => { btn.textContent = 'Copy prompt'; }, 2000);
  });
</script>


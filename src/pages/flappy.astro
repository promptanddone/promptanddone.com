---
// promptanddone.com/flappy — the FLAPPY pack (DM deliverable for the "Same prompt, three AIs" reel).
import BaseLayout from '../layouts/BaseLayout.astro';

const prompt = `Make a playable Flappy Bird-style game in a single index.html file. Include a demo mode where the bird flies itself until a key is pressed.`;

const rounds = [
  ['1', '1:18 · 26¢ ✓', '8:33 · 37¢ ✓', '7:37 · $0 ✗ bird lasts 0.3 s'],
  ['2', '1:34 · 41¢ ✓', '7:51 · 33¢ ✓', '3:03 · $0 ✗ no file'],
  ['3', '1:33 · 43¢ ✓', '5:14 · 24¢ ✓', '7:47 · $0 ✗ crashes on load'],
];
---
<BaseLayout title="The FLAPPY pack — Prompt &amp; Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · FLAPPY pack</p>
      <h1>Same prompt, three AIs</h1>
      <p class="tag">Claude Opus 5.5, GPT-6.1 Sol and Qwen 3.5 (free, running on a laptop) got the same one-line prompt. Here are all three games exactly as they wrote them, the prompt, and all three rounds.</p>
    </header>

    <section class="card" aria-labelledby="p1">
      <h2 id="p1"><span class="n">1</span> Play all three games</h2>
      <p class="sub">Round 1, unedited. Claude's and GPT's open in demo mode: the bird flies itself until you press a key. Qwen's opens on a start screen: press START DEMO MODE and watch.</p>
      <div class="games">
        <a class="game" href="/flappy/claude.html" target="_blank" rel="noopener" data-umami-event="flappy-play-claude">
          <strong>Claude Opus 5.5's game</strong>
          <span>Built in 1:18 · 26¢</span>
        </a>
        <a class="game" href="/flappy/gpt.html" target="_blank" rel="noopener" data-umami-event="flappy-play-gpt">
          <strong>GPT-6.1 Sol's game</strong>
          <span>Built in 8:33 · 37¢</span>
        </a>
        <a class="game" href="/flappy/qwen.html" target="_blank" rel="noopener" data-umami-event="flappy-play-qwen">
          <strong>Qwen 3.5's game (free, local)</strong>
          <span>Built in 7:37 · $0 · the one that ends before you blink</span>
        </a>
      </div>
    </section>

    <section class="card" aria-labelledby="p2">
      <h2 id="p2"><span class="n">2</span> The exact prompt</h2>
      <p class="sub">Paste it into Claude Code, Codex or any AI that writes code, then open the file in a browser.</p>
      <div class="prompt">{prompt}</div>
      <button class="copy" type="button">Copy prompt</button>
    </section>

    <section class="card how" aria-labelledby="p3">
      <h2 id="p3"><span class="n">3</span> All three rounds</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Round</th><th>Claude Opus 5.5</th><th>GPT-6.1 Sol</th><th>Qwen 3.5 (local)</th></tr></thead>
          <tbody>
            {rounds.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="sub">Claude finished first every round; GPT was cheaper in rounds 2 and 3; the free model never produced a working game. Claude Code 2.1.296 and Codex CLI 0.162.1 (effort high); Qwen3.5-9B (Q4, Apache-2.0) in Ollama 0.35.0 via Codex, on an M4 Pro MacBook. Tested 11 Oct 2026. Costs are API-equivalent at list prices (both paid tools ran on subscriptions): <a href="https://developers.openai.com/api/docs/pricing">OpenAI pricing</a> · <a href="https://huggingface.co/Qwen/Qwen3.5-9B">Qwen3.5-9B</a>.</p>
    </section>

    <footer>© Prompt &amp; Done</footer>
  </main>
</BaseLayout>

<script define:vars={{ prompt }}>
  const btn = document.querySelector('.copy');
  btn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(prompt); btn.textContent = 'Copied ✓'; }
    catch (e) { btn.textContent = 'Copy failed — select manually'; }
    setTimeout(() => { btn.textContent = 'Copy prompt'; }, 2000);
  });
</script>

<style>
  main {
    width: min(100% - 2.25rem, 44rem);
    margin: 0 auto;
    padding: clamp(2rem, 7vh, 4rem) 0 2.5rem;
  }
  .kicker { font-size: .85rem; color: var(--soft); margin: 0 0 1.25rem; }
  .kicker a { color: var(--accent); text-decoration: none; font-weight: 700; }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 8.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.03em;
    white-space: normal;
  }
  .tag { margin: 1rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--soft); }
  .card {
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.4rem 1.35rem;
    background: #101011;
  }
  .card h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -.01em;
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: #191100;
    font-size: 1.05rem;
    flex: none;
  }
  .sub { margin: .6rem 0 0; color: var(--soft); font-size: .95rem; }
  .prompt {
    margin-top: 1rem;
    white-space: pre-wrap;
    font-size: .92rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: .6rem;
    padding: 1rem 1.1rem;
    overflow-wrap: anywhere;
  }
  .copy {
    margin-top: .9rem;
    display: inline-block;
    font-family: inherit;
    font-weight: 700;
    font-size: .95rem;
    color: #191100;
    background: var(--accent);
    border: none;
    border-radius: .6rem;
    padding: .7rem 1.3rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .how ol, .how ul { margin: .8rem 0 0; padding-left: 1.3rem; line-height: 1.7; color: var(--ink); }
  .how li { margin-bottom: .5rem; }
  .sub a { color: var(--accent); }
  footer { margin-top: 2.5rem; color: var(--soft); font-size: .85rem; }
  .games { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: 1rem; }
  .game {
    display: flex; flex-direction: column; gap: .3rem;
    padding: 1rem; border-radius: .8rem; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); text-decoration: none;
  }
  .game strong { font-size: 1.05rem; }
  .game span { color: var(--soft); font-size: .9rem; }
  .game:hover, .game:focus-visible { border-color: var(--accent); }
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--soft); font-weight: 600; }
  @media (max-width: 30rem) { .games { grid-template-columns: 1fr; } }
</style>

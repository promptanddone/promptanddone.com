---
// Redirect stub: promptanddone.com/go/learn
const target = 'https://github.com/rohitg00/ai-engineering-from-scratch';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`1;url=${target}`} />
    <title>AI Engineering from Scratch — Prompt &amp; Done</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="bcc826ef-5592-45d9-89ac-eb7eb243acb2"></script>
    <script define:vars={{ target }}>
      // Hold 500ms so the Umami pageview beacon fires before the redirect.
      setTimeout(function () {
        window.location.replace(target);
      }, 500);
    </script>
  </head>
  <body>
    <p>Taking you to AI Engineering from Scratch…</p>
    <p><a href={target}>Tap here if you're not redirected.</a></p>
  </body>
</html>

    <meta http-equiv="refresh" content={`1;url=${target}`} />
    <title>REFCHECK pack — Prompt &amp; Done</title>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="bcc826ef-5592-45d9-89ac-eb7eb243acb2"></script>
    <script define:vars={{ target }}>
      setTimeout(function () { window.location.replace(target); }, 500);
    </script>
  </head>
  <body>
    <p>Taking you to the REFCHECK pack…</p>
    <p><a href={target}>Tap here if you're not redirected.</a></p>
  </body>
</html>

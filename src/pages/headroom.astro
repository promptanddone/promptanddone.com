---
// promptanddone.com/headroom: the HEADROOM test kit (DM deliverable for the "headroom-token-test" reel).
import PackLayout from '../layouts/PackLayout.astro';
const agent = 'from headroom import compress\n\n# messages: your Anthropic-style messages list, with the big log as a tool_result\nresult = compress(messages, model="claude-sonnet-5-5")\nprint(result.tokens_before, "->", result.tokens_before - result.tokens_saved)\nmessages = result.messages  # send these to Claude instead';
const install = 'uv tool install --python 3.13 "headroom-ai[all]"\nHEADROOM_BEACON=off headroom wrap claude\n# undo:\nheadroom unwrap claude';
const bench = "# Generates the scratch shop-api bench (run inside the repo dir). Seeded, deterministic.\nimport json, random, datetime, math, os\nfor d in ('config', 'test', 'logs', 'src'): os.makedirs(d, exist_ok=True)\nrandom.seed(7)\nwords=[\"SPRING\",\"SUMMER\",\"FALL\",\"WINTER\",\"VIP\",\"WELCOME\",\"FLASH\",\"CYBER\",\"BLACK\",\"LOYAL\",\"STUDENT\",\"BDAY\",\"FRIEND\",\"APP\",\"EMAIL\",\"HOLIDAY\",\"NEW\",\"BACK\",\"TEAM\",\"GIFT\"]\npcts=[5,10,15,20,25,30,40,50]; sufx=[\"\",\"A\",\"B\",\"X\",\"26\",\"NY\",\"LA\"]\nallc=[w+str(p)+s for w in words for p in pcts for s in sufx]\nrandom.shuffle(allc)\ncodes=[]\nfor c in allc[:900]:\n    if c==\"FALL25\": continue\n    codes.append({\"code\":c,\"percent\":random.choice(pcts),\"active\":random.random()>0.25,\n      \"created\":f\"2026-{random.randint(1,9):02d}-{random.randint(1,28):02d}\",\"owner\":random.choice([\"growth\",\"crm\",\"retail\",\"partnerships\",\"support\"]),\n      \"min_subtotal\":random.choice([0,0,25,50,100]),\"max_uses\":random.choice([100,500,1000,5000,None]),\"uses\":random.randint(0,4000),\n      \"channels\":random.sample([\"web\",\"ios\",\"android\",\"pos\",\"email\"],k=random.randint(1,4)),\"notes\":random.choice([\"\",\"seasonal\",\"partner campaign\",\"do not extend\",\"migrated from v1\"])})\ncodes.insert(617,{\"code\":\"FALL25\",\"percent\":\"25%\",\"active\":True,\"created\":\"2026-10-14\",\"owner\":\"growth\",\"min_subtotal\":0,\"max_uses\":5000,\"uses\":1843,\"channels\":[\"web\",\"ios\",\"android\"],\"notes\":\"fall campaign, imported from sheet\"})\njson.dump({\"version\":42,\"updated\":\"2026-10-14T09:12:44Z\",\"codes\":codes},open(\"config/discounts.json\",\"w\"),indent=2)\nact=[c for c in codes if c[\"active\"] and c[\"code\"]!=\"FALL25\"]\nL=[\"import { test } from 'node:test';\",\"import assert from 'node:assert/strict';\",\"import { checkoutTotal, applyDiscount } from '../src/pricing.js';\",\"\"]\nfor i in range(600):\n    c=random.choice(act); sub=round(random.uniform(5,400),2)\n    exp=math.floor(sub*(1-c[\"percent\"]/100)*100+0.5)/100\n    L.append(f\"test('discount {c['code']} on {sub}', () => {{ assert.equal(applyDiscount({sub}, '{c['code']}'), {exp}); }});\")\nL+=[\"test('checkout with FALL25 (fall campaign)', () => {\",\"  const total = checkoutTotal([{ price: 40, qty: 2 }, { price: 19.99, qty: 1 }], 'FALL25');\",\"  assert.equal(total, 80.99);\",\"});\"]\nfor i in range(40):\n    c=random.choice(act)\n    L.append(f\"test('checkout {i} with {c['code']}', () => {{ assert.ok(checkoutTotal([{{ price: 10, qty: {i+1} }}], '{c['code']}') > 0); }});\")\nopen(\"test/pricing.test.js\",\"w\").write(\"\\n\".join(L)+\"\\n\")\nt=datetime.datetime(2026,10,14,6,0,0); out=[]\npaths=[\"/api/cart\",\"/api/products\",\"/api/checkout\",\"/api/user\",\"/api/search\",\"/healthz\"]\nfor i in range(20000):\n    t+=datetime.timedelta(milliseconds=random.randint(200,1500))\n    rid=\"%08x\"%random.getrandbits(32); p=random.choice(paths)\n    if p==\"/api/checkout\" and t>datetime.datetime(2026,10,14,9,13) and random.random()<0.35:\n        out.append(f\"{t.isoformat()}Z ERROR req={rid} POST /api/checkout 500 code=FALL25 err=\\\"checkout total is NaN\\\" ms={random.randint(3,30)}\")\n    else:\n        lvl=random.choices([\"INFO\",\"DEBUG\",\"WARN\"],[70,25,5])[0]\n        st=200 if lvl!=\"WARN\" else random.choice([404,429])\n        out.append(f\"{t.isoformat()}Z {lvl} req={rid} {random.choice(['GET','POST'])} {p} {st} ms={random.randint(2,400)} ua=\\\"{random.choice(['ios/5.2','android/5.1','web/chrome','web/safari'])}\\\" region={random.choice(['us-east','us-west','eu-west'])}\")\nopen(\"logs/app.log\",\"w\").write(\"\\n\".join(out)+\"\\n\")\n";
const pricing = "import { readFileSync } from 'node:fs';\n\nconst discounts = JSON.parse(readFileSync(new URL('../config/discounts.json', import.meta.url)));\n\nexport function findDiscount(code) {\n  if (!code) return null;\n  return discounts.codes.find((d) => d.code === code.toUpperCase() && d.active) || null;\n}\n\nexport function applyDiscount(subtotal, code) {\n  const d = findDiscount(code);\n  if (!d) return subtotal;\n  const pct = Number(d.percent);\n  return Math.round(subtotal * (1 - pct / 100) * 100) / 100;\n}\n\nexport function checkoutTotal(items, code, taxRate = 0.08) {\n  const subtotal = items.reduce((s, it) => s + it.price * it.qty, 0);\n  const discounted = applyDiscount(subtotal, code);\n  const total = Math.round(discounted * (1 + taxRate) * 100) / 100;\n  if (Number.isNaN(total)) throw new Error('checkout total is NaN');\n  return total;\n}\n";
const pkg = "{\n  \"name\": \"shop-api\",\n  \"version\": \"1.4.2\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"test\": \"node --test --test-reporter=spec\" }\n}\n";
const ab = "#!/bin/bash\n# A/B: plain Claude Code vs `headroom wrap claude`, 3 runs each, interleaved, same prompt.\n# Needs: claude (Claude Code), headroom (uv tool install --python 3.13 \"headroom-ai[all]\"), node, a pristine copy of the bench in ./pristine\nQ='Checkout has been failing for some customers since Oct 14 and npm test is red. Use the test output and logs/app.log to find the root cause, fix it properly, and make npm test pass. Finish with a two-line summary of the cause and the fix.'\nexport HEADROOM_BEACON=off DO_NOT_TRACK=1\nfor n in 1 2 3; do\n  rm -rf runs/direct-$n runs/wrap-$n; mkdir -p runs\n  cp -R pristine runs/direct-$n; (cd runs/direct-$n && claude -p --model claude-sonnet-5-5 --allowedTools \"Bash Read Edit Write Grep Glob\" --output-format json \"$Q\" < /dev/null > ../direct-$n.json)\n  cp -R pristine runs/wrap-$n;   (cd runs/wrap-$n && headroom wrap claude --code-memory none -- -p --model claude-sonnet-5-5 --allowedTools \"Bash Read Edit Write Grep Glob mcp__headroom__headroom_retrieve\" --output-format json \"$Q\" < /dev/null > ../wrap-$n.json)\ndone\n# input tokens = usage.input_tokens + cache_creation_input_tokens + cache_read_input_tokens; cost = total_cost_usd\nheadroom unwrap claude\n";
const squeeze = "# pip install \"headroom-ai[all]\"   (run with HEADROOM_BEACON=off)\nfrom headroom import compress\nlog = open('slice.log').read()          # 2,500 lines around the first error in logs/app.log\nmsgs = [{\"role\": \"user\", \"content\": \"why did checkout fail?\"},\n        {\"role\": \"assistant\", \"content\": [{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Bash\", \"input\": {\"command\": \"cat slice.log\"}}]},\n        {\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"t1\", \"content\": log}]}]\nr = compress(msgs, model=\"claude-sonnet-5-5\")\nprint(r.tokens_before, '->', r.tokens_before - r.tokens_saved)   # we got 112,029 -> 4,310\n";
const rows = [['direct 1', '191,027', '$0.1152'], ['headroom 1', '179,977', '$0.1121'], ['direct 2', '185,540', '$0.1129'], ['headroom 2', '147,303', '$0.1019'], ['direct 3', '187,020', '$0.1145'], ['headroom 3', '222,823', '$0.1289'], ['mean direct', '187,862', '$0.1142'], ['mean headroom', '183,368', '$0.1143']];
---
<PackLayout title="Headroom token test kit — Prompt &amp; Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · HEADROOM test kit</p>
      <h1>94% fewer tokens: where Headroom wins (and where it doesn't)</h1>
      <p class="tag"><a href="https://github.com/headroomlabs-ai/headroom">Headroom</a> (free, Apache-2.0) compresses what your AI agent reads before the model sees it. When your own code sends a big log to Claude, it's dramatic: 94% fewer tokens, same answer. Inside Claude Code I measured about 2%. Run it yourself.</p>
    </header>
    <section class="card"><h2><span class="n">1</span> What I found (20 Oct 2026)</h2>
      <p><b>The win: a big log sent straight to Claude.</b> I asked Claude (Sonnet 5.5) the same question about a 2,502-line server log, three times with the full log and three times with the log squeezed by <code>headroom.compress()</code> (94 lines kept). Full log: 149,481 input tokens and about $0.60 per question (API-equivalent, list price). Squeezed: 8,754 tokens and about $0.04. That's 94% fewer tokens. All six answers named the same first error and the same cause. One thing you lose: from the squeezed log Claude couldn't give the exact error count (it said so and pointed to the retrieve hash).</p>
      <p><b>Use it in your own agent or script</b> (Python, <code>pip install "headroom-ai[all]"</code>):</p>
      <pre><code>{agent}</code></pre>
      <p><b>Why Claude Code barely benefits:</b> when a command prints too much, Claude Code saves the output to a file and shows the model a 2KB preview ("Output too large (252.9KB) … Preview (first 2KB)"), then greps it. Headroom also skips Read, Grep and WebFetch results by design. A <code>cat</code> of the same log inside Claude Code: 88,454 tokens without Headroom, 86,512 with it.</p>
      <p><b>Everyday Claude Code (bug fix):</b> same bug-fix prompt, 3 runs with <code>headroom wrap claude</code> and 3 without, interleaved. All six fixed the bug (641/641 tests). Input tokens per run (input + cache write + cache read) and Claude Code's API-equivalent cost:</p>
      <table>{rows.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</table>
      <p>That's 2.4% fewer input tokens and the same bill. The spread between runs is bigger than the difference, so treat it as "no meaningful saving on this task". Why: Claude Code already runs <code>tail</code> and <code>grep</code> instead of reading whole logs, so there was little left to squeeze.</p>
      <p>Setup: Headroom 0.41.0, Claude Code 2.1.303, Sonnet 5.5, Max plan (headless <code>claude -p</code>). Three runs per arm is a small sample. Your workload may differ: big MCP/JSON outputs and agents you build on the API are where it's designed to help.</p></section>
    <section class="card"><h2><span class="n">2</span> Install, run, undo</h2>
      <pre><code>{install}</code></pre>
      <p>Heads-up: an anonymous telemetry beacon is on by default (<code>HEADROOM_BEACON=off</code> turns it off). <code>wrap</code> registers an MCP server for Claude Code; <code>unwrap</code> removes it.</p></section>
    <section class="card"><h2><span class="n">3</span> The bench (a shop API with one planted bug)</h2>
      <p>Make an empty folder, save these files, run <code>python3 make_bench.py</code>, then <code>git init && git add -A && git commit -m bench</code>. You get 641 tests (one fails), a 14,000-line <code>config/discounts.json</code> and a 20,000-line <code>logs/app.log</code>. The bug: the <code>FALL25</code> code has <code>"percent": "25%"</code>, so checkout totals become NaN.</p>
      <details><summary><code>make_bench.py</code></summary><pre><code>{bench}</code></pre></details>
      <details><summary><code>src/pricing.js</code></summary><pre><code>{pricing}</code></pre></details>
      <details><summary><code>package.json</code></summary><pre><code>{pkg}</code></pre></details></section>
    <section class="card"><h2><span class="n">4</span> The A/B script</h2>
      <details open><summary><code>ab.sh</code></summary><pre><code>{ab}</code></pre></details>
      <details><summary><code>squeeze.py</code> (the giant-log test)</summary><pre><code>{squeeze}</code></pre></details></section>
  </main>
</PackLayout>

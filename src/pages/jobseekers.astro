---
// promptanddone.com/jobseekers — the JOBS keyword DM deliverable.
// 10 AI tools for job seekers, each linking to the official site.
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { n: 1, name: 'ChatGPT', task: 'Mock interviews', blurb: 'Practice interviews out loud with voice mode — it plays the hiring manager and grills you before the real thing.', href: 'https://chatgpt.com' },
  { n: 2, name: 'Claude', task: 'Cover letters', blurb: 'Turns your resume bullet points into tailored, human-sounding cover letters in seconds.', href: 'https://claude.ai' },
  { n: 3, name: 'Teal', task: 'Building your resume', blurb: 'Free AI resume builder that tailors your resume to each job description you paste in.', href: 'https://www.tealhq.com' },
  { n: 4, name: 'Jobscan', task: 'Beating resume bots', blurb: 'Scores your resume against the job post so you get past the ATS filters most companies use.', href: 'https://www.jobscan.co' },
  { n: 5, name: 'LinkedIn', task: 'Finding jobs', blurb: 'Still the biggest job board — its AI matching surfaces roles actually worth your application.', href: 'https://www.linkedin.com' },
  { n: 6, name: 'Canva', task: 'Resume design', blurb: 'Polished, recruiter-friendly resume templates you can customize in minutes, no design skills needed.', href: 'https://www.canva.com' },
  { n: 7, name: 'Grammarly', task: 'Polishing your writing', blurb: 'Catches the typos, grammar slips, and tone issues that get resumes tossed in seconds.', href: 'https://www.grammarly.com' },
  { n: 8, name: 'Huntr', task: 'Tracking applications', blurb: 'A kanban board for your job hunt — track every application, interview, and follow-up in one place.', href: 'https://huntr.co' },
  { n: 9, name: 'Levels.fyi', task: 'Salary research', blurb: 'Real, verified salary data by role and company — so you never lowball yourself in negotiations.', href: 'https://www.levels.fyi' },
  { n: 10, name: 'Final Round AI', task: 'Interview prep', blurb: 'AI interview copilot with mock interviews, resume feedback, and real-time guidance.', href: 'https://www.finalroundai.com' },
];
---
<BaseLayout title="10 AI Tools for Job Seekers — Prompt & Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · JOBS toolkit</p>
      <h1>10 AI Tools for<br />Job Seekers</h1>
      <p class="tag">The full list from the reel — resume, applications, interviews, salary. Tap any tool to open its official site.</p>
    </header>

    {tools.map((t) => (
      <section class="card" aria-label={`${t.n}. ${t.name}`}>
        <h2><span class="n">{t.n}</span> {t.name}</h2>
        <p class="sub">{t.task}</p>
        <p class="blurb">{t.blurb}</p>
        <a class="go" href={t.href} target="_blank" rel="noopener">Visit {t.name} →</a>
      </section>
    ))}

    <footer>© Prompt &amp; Done</footer>
  </main>
</BaseLayout>

<style>
  main {
    width: min(100% - 2.25rem, 44rem);
    margin: 0 auto;
    padding: clamp(2rem, 7vh, 4rem) 0 2.5rem;
  }
  .kicker { font-size: .85rem; color: var(--soft); margin: 0 0 1.25rem; }
  .kicker a { color: var(--accent); text-decoration: none; font-weight: 700; }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 8.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.03em;
    white-space: normal;
  }
  .tag { margin: 1rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--soft); }
  .card {
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.4rem 1.35rem;
    background: #101011;
  }
  .card h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -.01em;
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: #191100;
    font-size: 1.05rem;
    flex: none;
  }
  .sub { margin: .6rem 0 0; color: var(--accent); font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .blurb { margin: .5rem 0 0; color: var(--ink); font-size: .95rem; line-height: 1.55; }
  .go {
    margin-top: 1rem;
    display: inline-block;
    font-weight: 700;
    font-size: .95rem;
    color: #191100;
    background: var(--accent);
    border-radius: .6rem;
    padding: .7rem 1.3rem;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  footer { margin-top: 2.5rem; color: var(--soft); font-size: .85rem; }
</style>

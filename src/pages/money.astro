---
// promptanddone.com/money — the MONEY keyword DM deliverable.
// 10 AI tools that make you money, each linking to the official site or repo.
import PackLayout from '../layouts/PackLayout.astro';

const tools = [
  { n: 1, name: 'Canoe', task: 'AI brand visibility', blurb: 'Contentstack\'s new AI visibility tool (launched Oct 1) shows brands what AI search engines tell buyers about them — and whether competitors are winning the answer. Free plan.', href: 'https://www.contentstack.com' },
  { n: 2, name: 'Flow', task: 'Support on autopilot', blurb: 'ServiceNow\'s new AI service desk (launched Oct 1) resolves employee issues inside Slack, Teams, and email — deploys in a day with no infrastructure.', href: 'https://www.servicenow.com' },
  { n: 3, name: 'Synthesia', task: 'Coach at scale', blurb: 'Turn one recording into an AI avatar that coaches your whole audience — sell courses and coaching without filming every session.', href: 'https://www.synthesia.io' },
  { n: 4, name: 'ElevenLabs', task: 'Sell voiceovers', blurb: 'The voice AI leader (Eleven v4 just dropped): clone voices, narrate audiobooks, and sell voiceover work without a studio.', href: 'https://elevenlabs.io' },
  { n: 5, name: 'Robinhood', task: 'AI trades for you', blurb: 'Robinhood Agents (newly announced): AI agents that help with your money moves, right inside the app you already trade in.', href: 'https://robinhood.com' },
  { n: 6, name: 'MoneyPrinterTurbo', task: 'Faceless videos', blurb: 'Open-source and 128k stars: type one keyword and it generates an entire short video — script, voiceover, visuals. The faceless-video money machine.', href: 'https://github.com/harry0703/MoneyPrinterTurbo' },
  { n: 7, name: 'OpenShell', task: 'Private AI agents', blurb: 'NVIDIA\'s open-source agent shell (14k stars): run AI agents on your own machine — your data never leaves your computer.', href: 'https://github.com/NVIDIA/OpenShell' },
  { n: 8, name: 'Skills', task: 'Freelance like a senior', blurb: 'Matt Pocock\'s 274k-star collection of agent skills: workflows that turn your AI coding agent into a senior engineer — ship client work faster.', href: 'https://github.com/mattpocock/skills' },
  { n: 9, name: 'OpenRig', task: 'AI agent teams', blurb: 'Open-source: run a whole team of AI agents on different tasks at once — like hiring a crew that never sleeps.', href: 'https://github.com/mvschwarz/openrig' },
  { n: 10, name: 'Pi', task: 'Every AI model, one terminal', blurb: '111k stars: one terminal toolkit with a unified LLM API, agent loop, and coding agent — every model, one interface.', href: 'https://github.com/earendil-works/pi' },
];
---
<PackLayout title="10 AI Tools That Make You Money — Prompt & Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · MONEY toolkit</p>
      <h1>10 AI Tools That<br />Make You Money</h1>
      <p class="tag">The full list from the reel — half of these launched this week. Tap any tool to open its official site.</p>
    </header>

    {tools.map((t) => (
      <section class="card" aria-label={`${t.n}. ${t.name}`}>
        <h2><span class="n">{t.n}</span> {t.name}</h2>
        <p class="label">{t.task}</p>
        <p class="blurb">{t.blurb}</p>
        <a class="go" href={t.href} target="_blank" rel="noopener">Visit {t.name} →</a>
      </section>
    ))}
  </main>
</PackLayout>


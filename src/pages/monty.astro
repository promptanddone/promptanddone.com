---
// promptanddone.com/monty — the MONTY page (DM deliverable for the "openmontage-one-prompt-video" reel).
import BaseLayout from '../layouts/BaseLayout.astro';

const prompt = `Make a 30-second vertical (9:16) documentary short about the Apollo 11 moon landing. Use real NASA footage only, with narration, music and word-level captions.`;
const run = [
  ['Prompts typed', '1'],
  ['Approvals asked', '4 (idea, scene plan, assets, edit)'],
  ['Wall time', '29 min 22 s (about 11.5 min waiting for the footage search)'],
  ['OpenMontage generation spend', '$0.00 (Claude usage is separate)'],
  ['API keys', 'none'],
  ['Output', '1080x1920, 30 s, real NASA + Wikimedia public-domain footage, local Piper voice, word-level captions'],
  ['Music', 'none: the zero-key music source was blocked that day, so we chose no music'],
  ['Tested', '18 Oct 2026 · Claude Code 2.1.302 · Opus 5.5 · Claude Max'],
];
---
<BaseLayout title="OpenMontage + Claude Code — Prompt &amp; Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · MONTY</p>
      <h1>OpenMontage: a video crew for Claude Code</h1>
      <p class="tag">Free, open-source (AGPL-3.0). You give your coding agent one prompt; it researches, writes, finds footage, voices, edits and captions, and asks you to approve each stage.</p>
    </header>

    <section class="card" aria-labelledby="p1">
      <h2 id="p1"><span class="n">1</span> Get it</h2>
      <p class="sub">Clone the repo, run its setup, open Claude Code in the folder.</p>
      <a class="game" href="https://github.com/calesthio/OpenMontage" target="_blank" rel="noopener" data-umami-event="monty-repo"><strong>github.com/calesthio/OpenMontage</strong><span>README, quick start, pipelines</span></a>
    </section>

    <section class="card" aria-labelledby="p2">
      <h2 id="p2"><span class="n">2</span> The exact prompt</h2>
      <p class="sub">The one we typed. Note it asked for music; that source was blocked in our run, so the video has none.</p>
      <div class="prompt">{prompt}</div>
      <button class="copy" type="button">Copy prompt</button>
    </section>

    <section class="card how" aria-labelledby="p3">
      <h2 id="p3"><span class="n">3</span> What happened in our run</h2>
      <div class="table-wrap"><table><tbody>{run.map((r) => <tr><th>{r[0]}</th><td>{r[1]}</td></tr>)}</tbody></table></div>
      <p class="sub">Setup notes: we put the virtualenv's bin on PATH and downloaded a Piper voice once (<code>python -m piper.download_voices en_US-lessac-medium</code>); the README doesn't spell that out. Footage is 720p archive film upscaled, so it's soft. Only tested with Claude Code on macOS.</p>
    </section>

    <footer>© Prompt &amp; Done</footer>
  </main>
</BaseLayout>

<script define:vars={{ prompt }}>
  const btn = document.querySelector('.copy');
  btn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(prompt); btn.textContent = 'Copied ✓'; }
    catch (e) { btn.textContent = 'Copy failed — select manually'; }
    setTimeout(() => { btn.textContent = 'Copy prompt'; }, 2000);
  });
</script>

<style>
  main {
    width: min(100% - 2.25rem, 44rem);
    margin: 0 auto;
    padding: clamp(2rem, 7vh, 4rem) 0 2.5rem;
  }
  .kicker { font-size: .85rem; color: var(--soft); margin: 0 0 1.25rem; }
  .kicker a { color: var(--accent); text-decoration: none; font-weight: 700; }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 8.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.03em;
    white-space: normal;
  }
  .tag { margin: 1rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--soft); }
  .card {
    margin-top: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.4rem 1.35rem;
    background: #101011;
  }
  .card h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -.01em;
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: #191100;
    font-size: 1.05rem;
    flex: none;
  }
  .sub { margin: .6rem 0 0; color: var(--soft); font-size: .95rem; }
  .prompt {
    margin-top: 1rem;
    white-space: pre-wrap;
    font-size: .92rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: .6rem;
    padding: 1rem 1.1rem;
    overflow-wrap: anywhere;
  }
  .copy {
    margin-top: .9rem;
    display: inline-block;
    font-family: inherit;
    font-weight: 700;
    font-size: .95rem;
    color: #191100;
    background: var(--accent);
    border: none;
    border-radius: .6rem;
    padding: .7rem 1.3rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .how ol, .how ul { margin: .8rem 0 0; padding-left: 1.3rem; line-height: 1.7; color: var(--ink); }
  .how li { margin-bottom: .5rem; }
  .sub a { color: var(--accent); }
  .sub code { font-size: .85em; overflow-wrap: anywhere; }
  footer { margin-top: 2.5rem; color: var(--soft); font-size: .85rem; }
  .game {
    margin-top: 1rem;
    display: flex; flex-direction: column; gap: .3rem;
    padding: 1rem; border-radius: .8rem; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); text-decoration: none;
  }
  .game strong { font-size: 1.05rem; }
  .game span { color: var(--soft); font-size: .9rem; }
  .game:hover, .game:focus-visible { border-color: var(--accent); }
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  th, td { text-align: left; vertical-align: top; padding: .5rem .6rem; border-bottom: 1px solid var(--line); }
  th { white-space: nowrap; }
  th { color: var(--soft); font-weight: 600; }
</style>

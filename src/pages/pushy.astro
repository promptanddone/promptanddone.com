---
// promptanddone.com/pushy: the PUSHY pack (DM deliverable for the "claude-skill-pushy-description" reel). Prepared, not deployed.
import PackLayout from '../layouts/PackLayout.astro';
const sentence = String.raw`<your plain description> Make sure to use this skill whenever the user mentions <topics>, even if they don't explicitly ask for <thing>.`;
const example = String.raw`---
name: commit-message
description: How to write a clear git commit message. Make sure to use this skill whenever the user mentions commits, commit messages, staging changes, or summarizing what was just changed in code, even if they don't explicitly ask for a 'commit message'.
---`;
const harness = String.raw`#!/usr/bin/env python3
"""Skill trigger test: do plain vs pushy skill descriptions get loaded?
usage: run_trigger_test.py MODEL VARIANT[,VARIANT] [--reps N] [--workers N] [--out DIR]
Each variant installs the 8 skills (same bodies, different descriptions) in a temp project, then sends
every prompt to claude -p with only Skill/Read/Glob/Grep tools and records whether the first reply loads a skill."""
import json, os, shutil, subprocess, sys, tempfile, concurrent.futures as cf, time
HERE = os.path.dirname(os.path.abspath(__file__))
D = json.load(open(os.path.join(HERE, 'skills.json')))
model, variants = sys.argv[1], sys.argv[2].split(',')
reps = int(sys.argv[sys.argv.index('--reps') + 1]) if '--reps' in sys.argv else 1
workers = int(sys.argv[sys.argv.index('--workers') + 1]) if '--workers' in sys.argv else 6
out = sys.argv[sys.argv.index('--out') + 1] if '--out' in sys.argv else os.path.join(HERE, 'results')
os.makedirs(out, exist_ok=True)

def desc(s, v):
    if v == 'plain': return s['plain']
    if v == 'pushy': return f"{s['plain']} Make sure to use this skill whenever the user mentions {s['triggers']}, even if they don't explicitly ask for {s['also']}."
    raise SystemExit('unknown variant ' + v)

def make_project(v):
    p = tempfile.mkdtemp(prefix=f'pd-skill-{v}-')
    for s in D['skills']:
        d = os.path.join(p, '.claude', 'skills', s['name']); os.makedirs(d)
        open(os.path.join(d, 'SKILL.md'), 'w').write(f"---\nname: {s['name']}\ndescription: {desc(s, v)}\n---\n\n{s['body']}\n")
    subprocess.run(['git', 'init', '-q'], cwd=p)
    return p

def run_one(job):
    proj, kind, want, prompt, rep = job
    t0 = time.time()
    r = subprocess.run(['claude', '-p', prompt, '--model', model, '--setting-sources', 'project', '--strict-mcp-config',
                        '--tools', 'Skill,Read,Glob,Grep', '--max-turns', '2', '--output-format', 'stream-json', '--verbose',
                        '--dangerously-skip-permissions'], cwd=proj, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=240)
    loaded, cost = [], 0
    for l in r.stdout.splitlines():
        try: e = json.loads(l)
        except Exception: continue
        if e.get('type') == 'assistant':
            for c in e['message'].get('content', []):
                if c.get('type') == 'tool_use' and c.get('name') == 'Skill': loaded.append(c['input'].get('skill') or c['input'].get('command'))
        if e.get('type') == 'result': cost = e.get('total_cost_usd') or 0
    return {'kind': kind, 'want': want, 'prompt': prompt, 'rep': rep, 'loaded': loaded, 'cost': cost, 'secs': round(time.time() - t0, 1)}

for v in variants:
    proj = make_project(v)
    jobs = [(proj, 'pos', s['name'], pr, rep) for s in D['skills'] for pr in s['prompts'] for rep in range(reps)]
    jobs += [(proj, 'neg', None, pr, rep) for pr in D['negatives'] for rep in range(reps)]
    with cf.ThreadPoolExecutor(workers) as ex: res = list(ex.map(run_one, jobs))
    json.dump({'model': model, 'variant': v, 'results': res}, open(os.path.join(out, f'{model}-{v}.json'), 'w'), indent=1)
    pos = [r for r in res if r['kind'] == 'pos']; neg = [r for r in res if r['kind'] == 'neg']
    hit = sum(1 for r in pos if r['want'] in r['loaded']); anyl = sum(1 for r in pos if r['loaded']); fp = sum(1 for r in neg if r['loaded'])
    print(f"{model} {v}: right skill {hit}/{len(pos)}  any skill {anyl}/{len(pos)}  false triggers {fp}/{len(neg)}  cost USD {sum(r['cost'] for r in res):.2f}", flush=True)
    shutil.rmtree(proj, ignore_errors=True)
`;
const sample = String.raw`{

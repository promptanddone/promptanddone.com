---
// promptanddone.com/scripts — the SCRIPTS prompt pack (DM deliverable).
import PackLayout from '../layouts/PackLayout.astro';

const prompt1 = `Act as a viral content strategist who studies short-form video for a living.

Analyze the top 20 performing short-form videos in the [NICHE] niche from the last 90 days. For each video, break down:

1. The exact hook — quote the first 3 seconds word for word
2. The format and structure (talking head, listicle, demo, storytime, etc.)
3. The core theme or promise (what the viewer gets)
4. Why it likely retained viewers past the first 3 seconds

Then summarize: the 5 most repeated hook patterns (quote real examples), the 3 highest-performing formats, and the themes with the strongest engagement. Be specific — quote real hook lines, never generalize.`;

const prompt2 = `Using the hook patterns, formats, and themes from your analysis above, write 30 days of short-form video scripts for my [NICHE] account, in my voice: [VOICE — e.g. direct, zero fluff, dry humor].

Rules for every script:
- Opens with a scroll-stopping hook (under 8 words)
- 20–30 seconds spoken, conversational — written to be said out loud
- Ends with a comment-driven CTA (a question, not "link in bio")

Deliver it as a posting calendar: Day 1 through Day 30, one script per day, each labeled with the hook pattern it uses. Make every hook feel like breaking news, not a pitch.`;
---
<PackLayout title="2 ChatGPT Prompts: 0 to 30M Views System — Prompt & Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · SCRIPTS pack</p>
      <h1>2 ChatGPT Prompts:<br />0 to 30M Views System</h1>
      <p class="tag">Paste them in order, fill in your niche, get 30 days of scripts in your voice.</p>
    </header>

    <section class="card" aria-labelledby="p1">
      <h2 id="p1"><span class="n">1</span> The Niche Decoder</h2>
      <p class="sub">Teardown the top 20 videos in your niche — hooks, formats, themes.</p>
      <div class="prompt" data-copy-target="prompt1">{prompt1}</div>
      <button class="copy" data-copy="prompt1" type="button">Copy prompt</button>
    </section>

    <section class="card" aria-labelledby="p2">
      <h2 id="p2"><span class="n">2</span> The 30-Day Script Engine</h2>
      <p class="sub">Turn that analysis into 30 days of scripts + a posting calendar.</p>
      <div class="prompt" data-copy-target="prompt2">{prompt2}</div>
      <button class="copy" data-copy="prompt2" type="button">Copy prompt</button>
    </section>

    <section class="card how" aria-labelledby="how">
      <h2 id="how">How to use them</h2>
      <ol>
        <li>Paste <strong>Prompt 1</strong> into ChatGPT (or Claude/Gemini), fill in your niche.</li>
        <li>Read the analysis — steal the 5 hook patterns for your niche.</li>
        <li>Paste <strong>Prompt 2</strong> in the <strong>same chat</strong>, fill in your voice. It builds on the analysis.</li>
        <li>Film one script a day for 30 days. Don't edit the hooks — they're the point.</li>
      </ol>
    </section>
  </main>
</PackLayout>

<script define:vars={{ prompt1, prompt2 }}>
  const packs = { prompt1, prompt2 };
  document.querySelectorAll('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const key = btn.getAttribute('data-copy');
      try {
        await navigator.clipboard.writeText(packs[key]);
        btn.textContent = 'Copied ✓';
      } catch (e) {
        btn.textContent = 'Copy failed — select manually';
      }
      setTimeout(() => { btn.textContent = 'Copy prompt'; }, 2000);
    });
  });
</script>


---
// promptanddone.com/study — the STUDY keyword DM deliverable.
// 10 AI tools for students, each linking to the official site.
import PackLayout from '../layouts/PackLayout.astro';

const tools = [
  { n: 1, name: 'Khanmigo', task: 'A tutor that never sleeps', blurb: 'Khan Academy\'s AI tutor. Socratic-style: it guides you through problems instead of handing you answers.', href: 'https://www.khanacademy.org' },
  { n: 2, name: 'Perplexity', task: 'Research with receipts', blurb: 'Research assistant that answers with linked, checkable citations. Verified students get Pro free for 12 months.', href: 'https://www.perplexity.ai' },
  { n: 3, name: 'Otter.ai', task: 'Lectures on autopilot', blurb: 'Records and transcribes lectures live so you never miss a note.', href: 'https://otter.ai' },
  { n: 4, name: 'Quizlet', task: 'Study smarter', blurb: 'AI-generated adaptive flashcards and mock exams built from your study material.', href: 'https://quizlet.com' },
  { n: 5, name: 'Speechify', task: 'Read with your ears', blurb: 'Turns textbooks and PDFs into natural-sounding audio for studying on the go.', href: 'https://www.speechify.com' },
  { n: 6, name: 'Grammarly', task: 'Write it right', blurb: 'Grammar and clarity checking with a free tier, plus a student-friendly premium plan.', href: 'https://www.grammarly.com' },
  { n: 7, name: 'Gamma', task: 'Decks in seconds', blurb: 'Turn an outline into a polished slide deck in seconds.', href: 'https://gamma.app' },
  { n: 8, name: 'Cuey', task: 'Compare AI answers', blurb: 'Launched this week (Product Hunt #3 Product of the Day): a Chrome extension that compares ChatGPT, Claude, and Gemini answers side by side in a single tab.', href: 'https://www.producthunt.com/products/cuey-2' },
  { n: 9, name: 'SubSchool', task: 'Lectures into courses', blurb: 'Turns lecture videos into structured courses with AI-generated homework.', href: 'https://subschool.us' },
  { n: 10, name: 'Notion', task: 'One workspace', blurb: 'Organize classes, notes, and deadlines in one place.', href: 'https://www.notion.so' },
];
---
<PackLayout title="10 AI Tools for Students — Prompt & Done">
  <main>
    <header>
      <p class="kicker"><a href="/">Prompt &amp; Done</a> · STUDY toolkit</p>
      <h1>10 AI Tools<br />for Students</h1>
      <p class="tag">The full list from the reel — one of them launched this week. Tap any tool to open its official site.</p>
    </header>

    {tools.map((t) => (
      <section class="card" aria-label={`${t.n}. ${t.name}`}>
        <h2><span class="n">{t.n}</span> {t.name}</h2>
        <p class="label">{t.task}</p>
        <p class="blurb">{t.blurb}</p>
        <a class="go" href={t.href} target="_blank" rel="noopener">Visit {t.name} →</a>
      </section>
    ))}
  </main>
</PackLayout>

